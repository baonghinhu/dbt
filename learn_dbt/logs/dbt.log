{"data":{"node_info":{"unique_id":"model.learn_dbt.transaction"},"sql":"/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.learn_dbt.transaction\", \"profile_name\": \"dbt_project\", \"target_name\": \"dev\"} */\n\n\n  create or replace view `lerndbt`.`learn_dbt`.`transaction`\n  OPTIONS()\n  as select t.customer_transaction_id, c.customer_name,t.transaction_date, t.tax_amount, t.transaction_amount \r\nfrom vit-lam-data.wide_world_importers.sales__customer_transactions t\r\njoin vit-lam-data.wide_world_importers.sales__customers c\r\non t.customer_id = c.customer_id;\n\n"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fe455-d856-7730-96a7-d139077ab867","level":"debug","msg":"-- created_at: 2026-08-09T02:24:26.714104100+00:00\n-- finished_at: 2026-08-09T02:24:28.767848900+00:00\n-- elapsed: 2.1s\n-- outcome: success\n-- dialect: bigquery\n-- node_id: model.learn_dbt.transaction\n-- query_id: HJmOrysIKIlel8C2YRnAdvwS3Bv\n-- desc: execute adapter call\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.learn_dbt.transaction\", \"profile_name\": \"dbt_project\", \"target_name\": \"dev\"} */\n\n\n  create or replace view `lerndbt`.`learn_dbt`.`transaction`\n  OPTIONS()\n  as select t.customer_transaction_id, c.customer_name,t.transaction_date, t.tax_amount, t.transaction_amount \r\nfrom vit-lam-data.wide_world_importers.sales__customer_transactions t\r\njoin vit-lam-data.wide_world_importers.sales__customers c\r\non t.customer_id = c.customer_id;\n\n;","name":"SQLQuery","pid":4996,"thread":"tokio-rt-worker","ts":"2026-08-09T02:24:28.767888Z"}}
